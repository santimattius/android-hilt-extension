# Keep rules for the instrumented tests that run against the minified build type
# (-PtestBuildType=minified, see app/build.gradle.kts). AGP compiles the androidTest APK against the
# unshrunk app classes and R8 never sees the tests, so everything the tests reference by name or by
# reflection must be kept here. These rules apply only to a build that has androidTest enabled for the
# minified variant; production and consumer keep rules (proguard-rules.pro) are unchanged.

# Sample entry points and types the tests reference directly.
-keep class io.github.santimattius.android.sample.SampleApplication { *; }
-keep class io.github.santimattius.android.sample.MainActivity { *; }
-keep class io.github.santimattius.android.sample.android.DemoFragment { *; }
-keep class io.github.santimattius.android.sample.android.FragmentHostActivity { *; }
-keep class io.github.santimattius.android.sample.demo.DemoCardState { *; }
-keep class io.github.santimattius.android.sample.demo.DemoCatalog { *; }
-keep class io.github.santimattius.android.sample.demo.DemoSpec { *; }
-keep class io.github.santimattius.android.sample.demo.DemoId { *; }
-keep class io.github.santimattius.android.sample.ui.DemoScreenKt { *; }
-keep class io.github.santimattius.android.sample.ui.theme.ThemeKt { *; }

# AssistedCreationTraceTest reaches the assisted class and its entry point by name; nothing in the app
# references the entry point, so R8 would otherwise remove it.
-keep class io.github.santimattius.android.sample.demo.AssistedWidget { *; }
-keep class io.github.santimattius.android.sample.demo.AssistedWidget$Factory { *; }
-keep interface io.github.santimattius.android.sample.demo.AssistedWidgetEntryPoint { *; }
-keep class dagger.hilt.android.EntryPointAccessors { *; }

# MembersInjectorTraceTest reaches the injected class and its entry point by name; nothing in the app
# references the entry point, so R8 would otherwise remove it (NoClassDefFoundError).
-keep class io.github.santimattius.android.sample.demo.MembersInjectionTarget { *; }
-keep interface io.github.santimattius.android.sample.demo.MembersInjectionEntryPoint { *; }
# The app never calls MembersInjector.injectMembers (the component calls the static setters), so R8 drops
# the interface method; the test calls it through the interface.
-keep interface dagger.MembersInjector { *; }

# The tests reset the Hilt graph through GeneratedComponentManagerHolder and a reflective write to the
# private `component` field of the application component manager.
-keep class dagger.hilt.internal.GeneratedComponentManagerHolder { *; }
-keep class dagger.hilt.android.internal.managers.ApplicationComponentManager { *; }

# DeferredResolutionTraceTest reads the injected `registry` field of the real DemoViewModel by reflection;
# R8 renames it otherwise (NoSuchFieldException).
-keepclassmembers class io.github.santimattius.android.sample.demo.DemoViewModel { *** registry; }
-keep class io.github.santimattius.android.sample.demo.DemoRegistry { *; }
-keep interface io.github.santimattius.android.sample.demo.SuspendDemo { *; }

# Library classes the tests call directly. AGP applies the app's R8 mapping to the androidTest run, so a
# test reference to a library class only resolves when the app run kept it. R8 had removed 143 library
# types that the test dex references by original name (Compose UI/runtime test hooks such as
# ViewRootForTest and SemanticsOwnerKt, androidx.tracing.Trace/Tracer, kotlin and coroutines intrinsics,
# ...), which fails with NoClassDefFoundError once the instrumentation loads the tests. Kept by package
# because the tests reach them through inline functions and ServiceLoader-style lookups; this only widens
# what the test-only run keeps, never production or consumer rules.
-keep class androidx.compose.** { *; }
-keep class androidx.activity.** { *; }
-keep class androidx.lifecycle.** { *; }
-keep class androidx.core.** { *; }
-keep class androidx.fragment.** { *; }
-keep class androidx.collection.** { *; }
-keep class androidx.concurrent.** { *; }
-keep class androidx.tracing.** { *; }
-keep class kotlin.** { *; }
-keep class kotlinx.** { *; }
-keep class com.google.common.util.concurrent.** { *; }

# AGP also runs R8 over the androidTest APK; errorprone annotations pulled in by the test dependencies
# reference a JDK-only class (missing_rules.txt generated by AGP).
-dontwarn javax.lang.model.element.Modifier
